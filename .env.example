TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_EMBEDDING_MODEL=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_PATH=data/bot.db
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=telegram_memory

RECENT_MESSAGES_LIMIT=10

MEMORY_MIN_IMPORTANCE=0.60
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_DUPLICATE_THRESHOLD=0.92
MEMORY_RELATED_THRESHOLD=0.78
MEMORY_RETRIEVAL_THRESHOLD=0.35
MEMORY_RETRIEVAL_LIMIT=8

WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS_LIMIT=5

LOG_LEVEL=INFO
